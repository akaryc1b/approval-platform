{
  "schemaVersion": 1,
  "scenarioManifest": "config/demo/purchase-payment-golden-path.json",
  "tenantId": "demo-purchase-payment",
  "businessKey": "DEMO-PP-0001",
  "connectorKey": "demo-directory",
  "defaultBackendOrigin": "http://127.0.0.1:8080",
  "clients": {
    "pc": {
      "label": "PC approval workbench",
      "route": "/approval/workbench",
      "defaultPort": 5777,
      "defaultActor": "demo-manager",
      "allowedActors": [
        "demo-admin",
        "demo-employee",
        "demo-manager",
        "demo-finance-reviewer",
        "demo-finance-approver-a",
        "demo-finance-approver-b"
      ]
    },
    "h5": {
      "label": "H5 approval center",
      "route": "/pages/task/list",
      "defaultPort": 9000,
      "defaultActor": "demo-finance-reviewer",
      "allowedActors": [
        "demo-admin",
        "demo-employee",
        "demo-manager",
        "demo-finance-reviewer",
        "demo-finance-approver-a",
        "demo-finance-approver-b"
      ]
    },
    "wechat": {
      "label": "WeChat Mini Program approval center",
      "route": "pages/task/list",
      "defaultActor": "demo-employee",
      "allowedActors": [
        "demo-admin",
        "demo-employee",
        "demo-manager",
        "demo-finance-reviewer",
        "demo-finance-approver-a",
        "demo-finance-approver-b"
      ]
    }
  },
  "expectedHandoff": [
    {
      "client": "pc",
      "actorId": "demo-manager",
      "taskDefinitionKey": "managerApproval"
    },
    {
      "client": "h5",
      "actorId": "demo-finance-reviewer",
      "taskDefinitionKey": "financeReview"
    },
    {
      "client": "h5",
      "actorId": "demo-finance-approver-a",
      "taskDefinitionKey": "financeCountersign"
    },
    {
      "client": "h5",
      "actorId": "demo-finance-approver-b",
      "taskDefinitionKey": "financeCountersign"
    },
    {
      "client": "wechat",
      "actorId": "demo-employee",
      "taskDefinitionKey": "paymentConfirmation"
    }
  ],
  "evidenceKeys": [
    "tenantId",
    "businessKey",
    "instanceId",
    "taskIds",
    "auditEventIds",
    "finalStatus"
  ],
  "nonClaims": [
    "CROSS_CLIENT_RUNTIME_NOT_EXECUTED",
    "PURCHASE_APPROVAL_E2E_NOT_EXECUTED",
    "WECHAT_PHYSICAL_DEVICE_NOT_VERIFIED",
    "PURCHASE_TO_PAYMENT_SANDBOX_E2E_NOT_EXECUTED"
  ]
}
