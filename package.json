{
  "name": "approval-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Production-oriented approval platform built on Flowable",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/akaryc1b/approval-platform.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": "^22.18.0 || ^24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build:packages": "pnpm --filter './packages/**' build",
    "check": "pnpm -r --if-present check",
    "clean": "pnpm -r --if-present clean",
    "postinstall": "pnpm sdk:test",
    "sdk:build": "pnpm --filter @approval-platform/sdk build",
    "sdk:test": "pnpm --filter @approval-platform/sdk test",
    "connector-smoke": "node examples/connector-smoke/cli.mjs",
    "connector-smoke:test": "node --test examples/connector-smoke/test/*.test.mjs",
    "demo:preflight": "node scripts/product-readiness/demo-preflight.mjs",
    "demo:scenario:check": "node scripts/product-readiness/purchase-payment-scenario-contract.mjs",
    "demo:seed:check": "node --test scripts/tests/product-readiness-demo-seed-boundary.test.mjs",
    "demo:backend:plan": "node scripts/product-readiness/demo-backend.mjs plan --json",
    "demo:backend:start": "node scripts/product-readiness/demo-backend.mjs start",
    "demo:backend:stop": "node scripts/product-readiness/demo-backend.mjs stop",
    "demo:client:plan": "node scripts/product-readiness/demo-client.mjs plan --json",
    "demo:client:pc": "node scripts/product-readiness/demo-client.mjs pc",
    "demo:client:h5": "node scripts/product-readiness/demo-client.mjs h5",
    "demo:client:wechat": "node scripts/product-readiness/demo-client.mjs wechat",
    "demo:clients:check": "node --test scripts/tests/product-readiness-cross-client-local-demo-boundary.test.mjs",
    "demo:runtime:plan": "node scripts/product-readiness/demo-runtime-evidence.mjs plan --json",
    "demo:runtime:observe": "node scripts/product-readiness/demo-runtime-evidence.mjs observe",
    "demo:runtime:check": "node --test scripts/tests/product-readiness-cross-client-runtime-evidence-boundary.test.mjs",
    "demo:runtime:pc-h5:plan": "node scripts/product-readiness/pc-h5-runtime-smoke.mjs plan --json",
    "demo:runtime:pc-h5": "node scripts/product-readiness/pc-h5-runtime-smoke.mjs run",
    "demo:runtime:pc-h5:check": "node --test scripts/tests/product-readiness-pc-h5-runtime-boundary.test.mjs",
    "demo:runtime:purchase-payment:e2e:plan": "node scripts/product-readiness/purchase-payment-e2e.mjs plan --json",
    "demo:runtime:purchase-payment:e2e": "node scripts/product-readiness/purchase-payment-e2e.mjs run",
    "demo:runtime:purchase-payment:e2e:check": "node --test scripts/tests/product-readiness-purchase-payment-e2e-boundary.test.mjs",
    "demo:runtime:purchase-payment:e2e:ci": "node scripts/product-readiness/pc-h5-runtime-smoke.mjs ci && node scripts/product-readiness/purchase-payment-e2e.mjs ci",
    "demo:quickstart:plan": "node scripts/product-readiness/demo-quickstart.mjs plan --json",
    "demo:quickstart": "node scripts/product-readiness/demo-quickstart.mjs start",
    "demo:quickstart:check": "node --test scripts/tests/product-readiness-quick-start-boundary.test.mjs",
    "demo:quickstart:ci": "node scripts/product-readiness/demo-quickstart.mjs ci",
    "web:bootstrap": "node scripts/upstream/bootstrap-vben.mjs",
    "web:clean": "node scripts/upstream/bootstrap-vben.mjs --clean",
    "web:install": "pnpm web:bootstrap && pnpm --dir .upstream/vben install --frozen-lockfile",
    "web:dev": "pnpm web:bootstrap && pnpm --dir .upstream/vben dev:ele",
    "web:typecheck": "pnpm web:bootstrap && pnpm --dir .upstream/vben --filter @vben/web-ele typecheck",
    "web:build": "pnpm web:bootstrap && pnpm --dir .upstream/vben build:ele",
    "web:benchmark:designer": "node scripts/benchmarks/approval-designer-topology-benchmark.mjs",
    "web:test:client-boundary": "node --test scripts/tests/approval-client-boundary.test.mjs && node --test scripts/tests/product-readiness-purchase-payment-e2e-boundary.test.mjs && node --test scripts/tests/product-readiness-quick-start-boundary.test.mjs && node scripts/product-readiness/demo-quickstart.mjs ci && node scripts/product-readiness/pc-h5-runtime-smoke.mjs ci && node scripts/product-readiness/purchase-payment-e2e.mjs ci",
    "web:test:form-renderer": "node --test scripts/tests/approval-form-renderer-protocol.test.mjs",
    "web:test:form-designer": "node --test scripts/tests/form-designer-sections.test.mjs",
    "mobile:bootstrap": "node scripts/upstream/bootstrap-unibest.mjs",
    "mobile:clean": "node scripts/upstream/bootstrap-unibest.mjs --clean",
    "mobile:install": "pnpm mobile:bootstrap && pnpm -C .upstream/unibest install --no-frozen-lockfile && pnpm -C .upstream/unibest init-baseFiles",
    "mobile:dev:h5": "pnpm mobile:bootstrap && pnpm -C .upstream/unibest init-baseFiles && pnpm -C .upstream/unibest dev:h5",
    "mobile:dev:weixin": "pnpm mobile:bootstrap && pnpm -C .upstream/unibest init-baseFiles && pnpm -C .upstream/unibest dev:mp-weixin",
    "mobile:typecheck": "pnpm mobile:bootstrap && pnpm -C .upstream/unibest init-baseFiles && pnpm -C .upstream/unibest type-check",
    "mobile:build:h5": "pnpm mobile:bootstrap && pnpm -C .upstream/unibest init-baseFiles && pnpm -C .upstream/unibest build:h5",
    "mobile:build:weixin": "pnpm mobile:bootstrap && pnpm -C .upstream/unibest init-baseFiles && pnpm -C .upstream/unibest build:mp-weixin",
    "ruoyi5:bootstrap": "node scripts/upstream/bootstrap-ruoyi5.mjs",
    "ruoyi5:clean": "node scripts/upstream/bootstrap-ruoyi5.mjs --clean",
    "ruoyi5:build": "pnpm ruoyi5:bootstrap && mvn -B -ntp -f .upstream/ruoyi5/pom.xml -pl ruoyi-extend/ruoyi-approval-host-starter -am -DskipTests package",
    "ruoyi6:bootstrap": "node scripts/upstream/bootstrap-ruoyi6.mjs",
    "ruoyi6:clean": "node scripts/upstream/bootstrap-ruoyi6.mjs --clean",
    "ruoyi6:build": "pnpm ruoyi6:bootstrap && mvn -B -ntp -f .upstream/ruoyi6/pom.xml -pl ruoyi-admin -am -DskipTests package"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
