    {"id":3,"type":"stat","title":"流程采样","description":"采样器报告的状态；数量面板还要求完整性记录规则通过。","datasource":{"type":"prometheus","uid":"$datasource"},"gridPos":{"x":6,"y":1,"w":6,"h":4},"fieldConfig":{"defaults":{"unit":"short","noValue":"未知","decimals":0,"mappings":[{"type":"value","options":{"0":{"text":"不可用","color":"red"},"1":{"text":"正常","color":"green"}}}]},"overrides":[]},"targets":[{"refId":"A","expr":"approval_workflow_sample_up{job=\"approval-platform\",environment=~\"${environment:regex}\",instance=~\"${instance:regex}\"}","legendFormat":"{{instance}}","instant":true,"range":false,"format":"time_series"}],"options":{"reduceOptions":{"calcs":["lastNotNull"],"fields":"","values":false},"colorMode":"value","graphMode":"none","textMode":"auto"}},
    {"id":4,"type":"stat","title":"Outbox 采样","description":"默认关闭；未启用或缺失时不补零。","datasource":{"type":"prometheus","uid":"$datasource"},"gridPos":{"x":12,"y":1,"w":6,"h":4},"fieldConfig":{"defaults":{"unit":"short","noValue":"未知","decimals":0,"mappings":[{"type":"value","options":{"0":{"text":"不可用","color":"red"},"1":{"text":"正常","color":"green"}}}]},"overrides":[]},"targets":[{"refId":"A","expr":"approval_outbox_sample_up{job=\"approval-platform\",environment=~\"${environment:regex}\",instance=~\"${instance:regex}\"}","legendFormat":"{{instance}}","instant":true,"range":false,"format":"time_series"}],"options":{"reduceOptions":{"calcs":["lastNotNull"],"fields":"","values":false},"colorMode":"value","graphMode":"none","textMode":"auto"}},
