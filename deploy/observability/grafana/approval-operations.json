    {"id":13,"type":"timeseries","title":"流程完成耗时 P95","description":"按终态区分的自然时间；不是日历 SLA，也不包含外部付款送达时间。无样本不补零。","datasource":{"type":"prometheus","uid":"$datasource"},"gridPos":{"x":0,"y":10,"w":12,"h":7},"fieldConfig":{"defaults":{"unit":"s","noValue":"未知","decimals":2,"custom":{"drawStyle":"line","lineInterpolation":"linear","lineWidth":1,"fillOpacity":8,"showPoints":"never","spanNulls":false}},"overrides":[]},"targets":[{"refId":"A","expr":"histogram_quantile(0.95, sum by (le, outcome) (rate(approval_process_duration_seconds_bucket{job=\"approval-platform\",environment=~\"${environment:regex}\",instance=~\"${instance:regex}\"}[$__rate_interval])))","legendFormat":"{{outcome}}","instant":false,"range":true,"format":"time_series"}],"options":{"legend":{"displayMode":"list","placement":"bottom","calcs":[]},"tooltip":{"mode":"multi","sort":"none"}}},
    {"id":14,"type":"timeseries","title":"任务等待时长 P95","description":"任务创建到正常领取的自然时间，仅计入提交成功的样本。","datasource":{"type":"prometheus","uid":"$datasource"},"gridPos":{"x":12,"y":10,"w":12,"h":7},"fieldConfig":{"defaults":{"unit":"s","noValue":"未知","decimals":2,"custom":{"drawStyle":"line","lineInterpolation":"linear","lineWidth":1,"fillOpacity":8,"showPoints":"never","spanNulls":false}},"overrides":[]},"targets":[{"refId":"A","expr":"histogram_quantile(0.95, sum by (le) (rate(approval_task_waiting_duration_seconds_bucket{job=\"approval-platform\",environment=~\"${environment:regex}\",instance=~\"${instance:regex}\"}[$__rate_interval])))","legendFormat":"{{instance}}","instant":false,"range":true,"format":"time_series"}],"options":{"legend":{"displayMode":"list","placement":"bottom","calcs":[]},"tooltip":{"mode":"multi","sort":"none"}}},
    {"id":15,"type":"timeseries","title":"审批命令耗时 P95","description":"命令回调到事务完成，不是 HTTP 时延或完整流程耗时；不计幂等缓存重放。","datasource":{"type":"prometheus","uid":"$datasource"},"gridPos":{"x":0,"y":17,"w":12,"h":7},"fieldConfig":{"defaults":{"unit":"s","noValue":"未知","decimals":2,"custom":{"drawStyle":"line","lineInterpolation":"linear","lineWidth":1,"fillOpacity":8,"showPoints":"never","spanNulls":false}},"overrides":[]},"targets":[{"refId":"A","expr":"histogram_quantile(0.95, sum by (le, operation) (rate(approval_command_duration_seconds_bucket{job=\"approval-platform\",environment=~\"${environment:regex}\",instance=~\"${instance:regex}\",outcome=\"committed\"}[$__rate_interval])))","legendFormat":"{{operation}}","instant":false,"range":true,"format":"time_series"}],"options":{"legend":{"displayMode":"list","placement":"bottom","calcs":[]},"tooltip":{"mode":"multi","sort":"none"}}},
