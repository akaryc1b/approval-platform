    {"id":7,"type":"stat","title":"运行中流程","description":"当前选中实例对应的数据库快照；不跨副本相加。缺失、过期、不完整时显示未知。覆盖为零不代表 SLA 达标。","datasource":{"type":"prometheus","uid":"$datasource"},"gridPos":{"x":0,"y":6,"w":4,"h":4},"fieldConfig":{"defaults":{"unit":"short","noValue":"未知","decimals":0},"overrides":[]},"targets":[{"refId":"A","expr":"approval_process_active{job=\"approval-platform\",environment=~\"${environment:regex}\",instance=~\"${instance:regex}\",workflow_monitor=\"enabled\"} and approval:workflow_population_sample_healthy{job=\"approval-platform\",environment=~\"${environment:regex}\",instance=~\"${instance:regex}\",workflow_monitor=\"enabled\"}","legendFormat":"{{instance}}","instant":true,"range":false,"format":"time_series"}],"options":{"reduceOptions":{"calcs":["lastNotNull"],"fields":"","values":false},"colorMode":"none","graphMode":"none","textMode":"auto"}},
