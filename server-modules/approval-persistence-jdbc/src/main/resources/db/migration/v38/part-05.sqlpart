  or (new.payload_json->'expectedActiveTaskDefinitionKeys')
    is distinct from new.active_task_definition_keys then
  raise exception using errcode='23514',
   message='migration plan instance payload does not match durable columns';
 end if;
 select array_agg(value order by ordinality),array_agg(value order by value)
  into ordered_keys,sorted_keys
  from jsonb_array_elements_text(new.active_task_definition_keys)
   with ordinality as keys(value,ordinality);
 if ordered_keys is distinct from sorted_keys
  or cardinality(ordered_keys)<>(select count(distinct value)
    from jsonb_array_elements_text(new.active_task_definition_keys) as values(value))
  or exists (
   select 1 from jsonb_array_elements_text(new.active_task_definition_keys) as values(value)
    where value='' or value<>btrim(value) or char_length(value)>128
  ) then
  raise exception using errcode='23514',
   message='migration plan task keys must be unique canonical ordered';
 end if;
 select * into plan_row from ap_process_migration_plan
  where tenant_id=new.tenant_id and plan_id=new.plan_id;
 if not found
  or plan_row.payload_json->'selectedInstances'->(new.sequence_no-1)
    is distinct from new.payload_json then
  raise exception using errcode='23514',
   message='migration plan selected instance does not match canonical plan content';
 end if;
 return new;
end $$;

create function ap_guard_process_migration_plan_authorization_v38()
returns trigger language plpgsql as $$
declare plan_row ap_process_migration_plan%rowtype;
begin
 if tg_op<>'INSERT' then
  raise exception using errcode='55000',
   message='migration plan authorization evidence is append-only';
 end if;
 if exists (
  select 1 from ap_process_migration_plan_authorization existing
   where existing.tenant_id=new.tenant_id and existing.plan_id=new.plan_id
    and existing.payload_json=new.payload_json
 ) then
  return new;
 end if;
 if exists (
  select 1 from ap_process_migration_plan_authorization existing
   where existing.tenant_id=new.tenant_id
    and (existing.plan_id=new.plan_id or existing.idempotency_key=new.idempotency_key)
 ) then
  raise exception using errcode='23505',
   message='migration plan authorization replay has different evidence';
 end if;
 if (new.payload_json->>'authorizationId')::uuid is distinct from new.authorization_id
  or (new.payload_json->>'tenantId') is distinct from new.tenant_id
  or (new.payload_json->>'planId')::uuid is distinct from new.plan_id
  or (new.payload_json->>'planHash') is distinct from new.plan_hash
  or (new.payload_json->>'selectedInstanceCount')::integer
    is distinct from new.selected_instance_count
  or (new.payload_json->>'sourceReleaseVersion')::integer
    is distinct from new.source_release_version
  or (new.payload_json->>'sourcePackageHash') is distinct from new.source_package_hash
  or (new.payload_json->>'targetReleaseVersion')::integer
    is distinct from new.target_release_version
  or (new.payload_json->>'targetPackageHash') is distinct from new.target_package_hash
  or (new.payload_json->>'authorizationPolicy') is distinct from new.authorization_policy
  or (new.payload_json->>'authorizationPolicyVersion')
    is distinct from new.authorization_policy_version
  or (new.payload_json->>'authorizationEvidenceHash')
    is distinct from new.authorization_evidence_hash
  or (new.payload_json->>'authorizedBy') is distinct from new.authorized_by
  or (new.payload_json->>'reason') is distinct from new.reason
  or (new.payload_json->>'idempotencyKey') is distinct from new.idempotency_key
  or ap_migration_json_instant_v37(new.payload_json,'decidedAt')
    is distinct from new.decided_at
  or ap_migration_json_instant_v37(new.payload_json,'expiresAt')
    is distinct from new.expires_at
  or (new.payload_json->>'requestId') is distinct from new.request_id
  or (new.payload_json->>'traceId') is distinct from new.trace_id
  or (new.payload_json->>'auditChainReference') is distinct from new.audit_chain_reference then
  raise exception using errcode='23514',
   message='migration plan authorization payload does not match durable columns';
 end if;
 select * into plan_row from ap_process_migration_plan
