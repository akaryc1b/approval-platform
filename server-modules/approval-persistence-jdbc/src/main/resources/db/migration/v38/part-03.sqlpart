  or (new.payload_json->>'sourceReleaseVersion')::integer
    is distinct from new.source_release_version
  or (new.payload_json->>'sourcePackageHash') is distinct from new.source_package_hash
  or (new.payload_json->>'targetReleaseVersion')::integer
    is distinct from new.target_release_version
  or (new.payload_json->>'targetPackageHash') is distinct from new.target_package_hash
  or (new.payload_json->>'targetDeploymentRecordId')::uuid
    is distinct from new.target_deployment_record_id
  or (new.payload_json->>'targetEngineDeploymentId')
    is distinct from new.target_engine_deployment_id
  or (new.payload_json->>'targetEngineDefinitionId')
    is distinct from new.target_engine_definition_id
  or (new.payload_json->>'targetEngineVersion')::integer
    is distinct from new.target_engine_version
  or jsonb_array_length(new.payload_json->'selectedInstances')
    is distinct from new.selected_instance_count
  or (new.payload_json->>'status') is distinct from new.status
  or (new.payload_json->>'revision')::bigint is distinct from new.revision
  or (new.payload_json->>'idempotencyKey') is distinct from new.idempotency_key
  or (new.payload_json->>'planHash') is distinct from new.plan_hash
  or (new.payload_json->>'requestedBy') is distinct from new.requested_by
  or (new.payload_json->>'operationReason') is distinct from new.operation_reason
  or ap_migration_json_instant_v37(new.payload_json,'assessedAt')
    is distinct from new.assessed_at
  or ap_migration_json_instant_v37(new.payload_json,'createdAt')
    is distinct from new.created_at
  or ap_migration_json_instant_v37(new.payload_json,'expiresAt')
    is distinct from new.expires_at
  or ap_migration_json_instant_v37(new.payload_json,'updatedAt')
    is distinct from new.updated_at
  or (new.payload_json->>'authorizationId')::uuid is distinct from new.authorization_id
  or (new.payload_json->>'authorizationEvidenceHash')
    is distinct from new.authorization_evidence_hash
  or (new.payload_json->>'authorizedBy') is distinct from new.authorized_by
  or ap_migration_json_instant_v37(new.payload_json,'authorizedAt')
    is distinct from new.authorized_at
  or ap_migration_json_instant_v37(new.payload_json,'authorizationExpiresAt')
    is distinct from new.authorization_expires_at
  or (new.payload_json->>'requestId') is distinct from new.request_id
  or (new.payload_json->>'traceId') is distinct from new.trace_id
  or (new.payload_json->>'auditChainReference') is distinct from new.audit_chain_reference
 then
  raise exception using errcode='23514',
   message='migration plan payload does not match durable columns';
 end if;
 select * into deployment_row from ap_approval_release_deployment
  where tenant_id=new.tenant_id and definition_key=new.definition_key
   and release_version=new.target_release_version;
 if not found or deployment_row.status is distinct from 'DEPLOYED'
  or deployment_row.deployment_record_id is distinct from new.target_deployment_record_id
  or deployment_row.release_package_hash is distinct from new.target_package_hash
  or deployment_row.engine_deployment_id is distinct from new.target_engine_deployment_id
  or deployment_row.engine_definition_id is distinct from new.target_engine_definition_id
  or deployment_row.engine_version is distinct from new.target_engine_version then
  raise exception using errcode='23514',
   message='migration plan target deployment identity is not current and exact';
 end if;
 if tg_op='INSERT' then
  if new.status<>'PROPOSED' or new.revision<>1 or new.authorization_id is not null then
   raise exception using errcode='23514',
    message='migration plan must begin PROPOSED revision 1 without authorization';
  end if;
 elsif (new.payload_json - array[
   'status','revision','updatedAt','authorizationId','authorizationEvidenceHash',
   'authorizedBy','authorizedAt','authorizationExpiresAt'
  ]) is distinct from (old.payload_json - array[
   'status','revision','updatedAt','authorizationId','authorizationEvidenceHash',
   'authorizedBy','authorizedAt','authorizationExpiresAt'
  ]) then
  raise exception using errcode='55000',
   message='migration plan canonical content is immutable';
 end if;
 return new;
